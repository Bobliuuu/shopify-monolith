# ======================================================
# Synthetic dataset generator environment example
# File: scripts/.env.example
# ======================================================

# -------------------------
# OpenAI image generation
# -------------------------
# Required only when using --generate-images
OPENAI_API_KEY=

# Optional override (default in generator.py is gpt-image-2)
OPENAI_IMAGE_MODEL=gpt-image-2


# -------------------------
# Cloudflare R2 upload
# -------------------------
# Required when using --upload-r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Provide one of:
# 1) Full endpoint URL (recommended), OR
# 2) Account ID (generator will derive endpoint)
R2_ENDPOINT_URL=
R2_ACCOUNT_ID=

# Optional object prefix in bucket
# Example: datasets/greenfield/2026-04-29
R2_PREFIX=datasets/greenfield


# -------------------------
# AWS-compatible fallbacks
# -------------------------
# The generator also accepts these if R2_* keys are not set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
