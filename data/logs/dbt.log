    create  table
      "shopify_monolith"."main_dev"."shopify_transactions_base__dbt_tmp"
  
    as (
      

select 
  transaction_id,
  order_id,
  customer_id,
  transaction_status,
  payment_method,
  transaction_amount,
  tax_amount,
  shipping_amount,
  currency,
  created_at,
  updated_at,
  country_code,
  sales_channel,
  -- Add some calculated fields
  transaction_amount + tax_amount + shipping_amount as total_amount,
  case 
    when transaction_status = 'completed' then transaction_amount
    else 0
  end as successful_amount,
  case 
    when created_at >= current_timestamp - interval '7 days' then 'recent'
    when created_at >= current_timestamp - interval '30 days' then 'recent_month'
    else 'older'
  end as transaction_recency
from "shopify_monolith"."main_dev"."stg_shopify_transactions_base"
    );
  
  
