[0m03:35:44.958256 [debug] [Thread-2 (]: On model.shopify_monolith.rpt_greenfield_retail_vs_extracted_orders: /* {"app": "dbt", "dbt_version": "1.10.6", "profile_name": "shopify_monolith", "target_name": "dev", "node_id": "model.shopify_monolith.rpt_greenfield_retail_vs_extracted_orders"} */

  
  create view "data"."main"."rpt_greenfield_retail_vs_extracted_orders__dbt_tmp" as (
    -- Reconcile ground-truth retail orders with extracted_orders (same keys as generator).


with retail as (
    select * from "main"."greenfield"."retail_orders"
),

extracted as (
    select * from "main"."greenfield"."extracted_orders"
)

select
    r.order_id as retail_order_id,
    r.order_number,
    r.customer_id as retail_customer_id,
    r.source_tx_id,
    r.source_invoice_no,
    r.payment_ref as retail_payment_ref,
    r.grand_total as retail_grand_total,
    e.doc_id,
    e.extraction_id,
    e.grand_total as extracted_grand_total,
    abs(coalesce(e.grand_total, 0) - coalesce(r.grand_total, 0)) as grand_total_abs_diff
from retail r
left join extracted e
    on r.source_tx_id = e.source_tx_id
    and r.source_invoice_no = e.source_invoice_no
  );

[0m03:35:44.958526 [debug] [Thread-1 (]: Using duckdb connection "model.shopify_monolith.rpt_greenfield_product_skus_bridge"
[0m03:35:44.958859 [debug] [Thread-1 (]: On model.shopify_monolith.rpt_greenfield_product_skus_bridge: /* {"app": "dbt", "dbt_version": "1.10.6", "profile_name": "shopify_monolith", "target_name": "dev", "node_id": "model.shopify_monolith.rpt_greenfield_product_skus_bridge"} */

  
  create view "data"."main"."rpt_greenfield_product_skus_bridge__dbt_tmp" as (
    -- Bridge retail SKUs to Shopify-staged products when both exist (SKU embedded in variants JSON).


with retail_skus as (
    select distinct sku, name, product_id, variant_id
    from "main"."greenfield"."retail_products"
)

select
    rs.sku as greenfield_retail_sku,
    rs.name as greenfield_product_name,
    rs.product_id as greenfield_product_id,
    sp.id as shopify_product_row_id,
    sp.title as shopify_product_title,
    sp.vendor as shopify_vendor,
    case
        when sp.variants is null then false
        else strpos(cast(sp.variants as varchar), rs.sku) > 0
    end as sku_found_in_shopify_variants_json
from retail_skus rs
left join "main"."shopify"."shopify_products" sp
    on strpos(cast(sp.variants as varchar), rs.sku) > 0
  );

